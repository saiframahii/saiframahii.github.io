@prefix : <https://w3id.org/occo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/occo#> .

<https://w3id.org/occo#> rdf:type owl:Ontology ;
                          owl:versionIRI <https://w3id.org/occo/0.1.1> ;
                          <http://purl.org/dc/terms/bibliographicCitation> "Alramahi, S., Mayouf, M., Del Zendeh, E., & Ismail, K. (2026). Towards a Semantic Ontology for Occupant-Centric Building Control. Submitted to EC3 2026 — 12th European Conference on Construction IT." ;
                          <http://purl.org/dc/terms/created> "2025-09-24"^^xsd:date ;
                          <http://purl.org/dc/terms/creator> "Saif Alramahi", "Mohammad Mayouf", "Elham Del Zendeh", "Khalid Ismail" ;
                          <http://purl.org/dc/terms/description> "A semantic framework for occupant-centric building control. This ontology is under active development and has not yet been fully validated."@en ;
                          <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                          <http://purl.org/dc/terms/modified> "2026-03-29"^^xsd:date ;
                          <http://purl.org/dc/terms/source> <https://github.com/saiframahii/saiframahii.github.io> ;
                          <http://purl.org/dc/terms/title> "Occupant-Centric Control Ontology (OCCO)"@en ;
                          <http://purl.org/ontology/bibo/status> "Ontology Specification Draft" ;
                          <http://purl.org/vocab/vann/preferredNamespacePrefix> "occo" ;
                          <http://purl.org/vocab/vann/preferredNamespaceUri> <https://w3id.org/occo#> ;
                          rdfs:comment "This ontology was developed as part of PhD research at Birmingham City University. The version presented here reflects the state at time of publication. The ontology will continue to evolve following formal validation and implementation."@en ;
                          owl:versionInfo "0.1.1-dev" ;
                          <https://w3id.org/mod#createdWith> <https://chowlk.linkeddata.es/> .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/bibliographicCitation
<http://purl.org/dc/terms/bibliographicCitation> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/ontology/bibo/status
<http://purl.org/ontology/bibo/status> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionIRI
owl:versionIRI rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


###  https://w3id.org/mod#createdWith
<https://w3id.org/mod#createdWith> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://qudt.org/schema/qudt/unit
<http://qudt.org/schema/qudt/unit> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <http://qudt.org/schema/qudt/QuantityValue> ;
                                   rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                   rdfs:isDefinedBy <http://qudt.org/schema/qudt/> ;
                                   rdfs:label "unit" .


###  http://www.w3.org/2006/time#hasBeginning
<http://www.w3.org/2006/time#hasBeginning> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://www.w3.org/2006/time#Interval> ;
                                           rdfs:range <http://www.w3.org/2006/time#Instant> ;
                                           rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
                                           rdfs:label "has beginning" .


###  http://www.w3.org/2006/time#hasEnd
<http://www.w3.org/2006/time#hasEnd> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <http://www.w3.org/2006/time#Interval> ;
                                     rdfs:range <http://www.w3.org/2006/time#Instant> ;
                                     rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
                                     rdfs:label "has end" .


###  http://www.w3.org/ns/prov#atLocation
<http://www.w3.org/ns/prov#atLocation> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://w3id.org/ofo#Feedback> ;
                                       rdfs:range <https://saref.etsi.org/saref4bldg/BuildingSpace> ;
                                       rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
                                       rdfs:label "at location" .


###  http://www.w3.org/ns/prov#generated
<http://www.w3.org/ns/prov#generated> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://www.w3.org/ns/sosa/Actuation> ;
                                      rdfs:range :PerformanceOutcome ;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
                                      rdfs:label "generated" .


###  http://www.w3.org/ns/prov#used
<http://www.w3.org/ns/prov#used> rdf:type owl:ObjectProperty ;
                                 rdfs:domain <http://www.w3.org/ns/sosa/Actuation> ;
                                 rdfs:range :ControlStrategy ;
                                 rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
                                 rdfs:label "used" .


###  http://www.w3.org/ns/prov#wasAssociatedWith
<http://www.w3.org/ns/prov#wasAssociatedWith> rdf:type owl:ObjectProperty ;
                                              rdfs:range <http://www.w3.org/ns/prov#Agent> ;
                                              rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
                                              rdfs:label "was associated with" .


###  http://www.w3.org/ns/prov#wasAttributedTo
<http://www.w3.org/ns/prov#wasAttributedTo> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <https://w3id.org/ofo#Feedback> ;
                                            rdfs:range <https://w3id.org/ofo#Person> ;
                                            rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
                                            rdfs:label "was attributed to" .


###  http://www.w3.org/ns/prov#wasInformedBy
<http://www.w3.org/ns/prov#wasInformedBy> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <http://www.w3.org/ns/sosa/Actuation> ;
                                          rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
                                          rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
                                          rdfs:label "was informed by" .


###  http://www.w3.org/ns/sosa/hasFeatureOfInterest
<http://www.w3.org/ns/sosa/hasFeatureOfInterest> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                                 rdfs:range <https://saref.etsi.org/saref4bldg/BuildingSpace> ;
                                                 rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                                 rdfs:label "has feature of interest" .


###  http://www.w3.org/ns/sosa/hasResult
<http://www.w3.org/ns/sosa/hasResult> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                      rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                      rdfs:label "has result" .


###  http://www.w3.org/ns/sosa/madeByActuator
<http://www.w3.org/ns/sosa/madeByActuator> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://www.w3.org/ns/sosa/Actuation> ;
                                           rdfs:range <http://www.w3.org/ns/sosa/Actuator> ;
                                           rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                           rdfs:label "made by actuator" .


###  http://www.w3.org/ns/sosa/madeBySensor
<http://www.w3.org/ns/sosa/madeBySensor> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                         rdfs:range <http://www.w3.org/ns/sosa/Sensor> ;
                                         rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                         rdfs:label "made by sensor" .


###  http://www.w3.org/ns/sosa/observedProperty
<http://www.w3.org/ns/sosa/observedProperty> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                             rdfs:range <http://www.w3.org/ns/sosa/ObservableProperty> ;
                                             rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                             rdfs:label "observed property" .


###  https://saref.etsi.org/saref4bldg/isContainedIn
<https://saref.etsi.org/saref4bldg/isContainedIn> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <https://saref.etsi.org/saref4bldg/Lamp> ;
                                                  rdfs:range <https://saref.etsi.org/saref4bldg/BuildingSpace> ;
                                                  rdfs:isDefinedBy <https://saref.etsi.org/saref4bldg/> ;
                                                  rdfs:label "is contained in" .


###  https://w3id.org/occo#appliesToSpace
:appliesToSpace rdf:type owl:ObjectProperty ;
                rdfs:domain :ControlStrategy ;
                rdfs:range <https://saref.etsi.org/saref4bldg/BuildingSpace> ;
                rdfs:comment "Relates a control strategy to the building space in which it is applied."@en ;
                rdfs:label "applies to space" .


###  https://w3id.org/occo#assessedAgainst
:assessedAgainst rdf:type owl:ObjectProperty ;
                 rdfs:domain :PerformanceOutcome ;
                 rdfs:range <http://purl.org/dc/terms/Standard> ;
                 rdfs:comment "Relates a performance outcome to the lighting standard used to evaluate compliance."@en ;
                 rdfs:label "assessed against" .


###  https://w3id.org/occo#forTask
:forTask rdf:type owl:ObjectProperty ;
         rdfs:domain :Preference ;
         rdfs:range :VisualTask ;
         rdfs:comment "Relates a preference to the visual task for which it is defined."@en ;
         rdfs:label "for task" .


###  https://w3id.org/occo#hasBaseline
:hasBaseline rdf:type owl:ObjectProperty ;
             rdfs:domain :PerformanceOutcome ;
             rdfs:range :PerformanceOutcome ;
             rdfs:comment "Relates a performance outcome to a reference baseline outcome against which it is compared. This property is directional: the subject is the measured outcome, the object is the baseline."@en ;
             rdfs:label "has baseline" .


###  https://w3id.org/occo#hasChronotype
:hasChronotype rdf:type owl:ObjectProperty ;
               rdfs:domain <https://w3id.org/ofo#Person> ;
               rdfs:range :Chronotype ;
               rdfs:comment "Relates a person to their chronotype classification, capturing their circadian activity pattern preference."@en ;
               rdfs:label "has chronotype" .


###  https://w3id.org/occo#hasEnergyConsumption
:hasEnergyConsumption rdf:type owl:ObjectProperty ;
                      rdfs:domain :PerformanceOutcome ;
                      rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
                      rdfs:comment "Relates a performance outcome to the energy consumption recorded during the associated lighting control actuation, expressed as a quantity value."@en ;
                      rdfs:label "has energy consumption" .


###  https://w3id.org/occo#hasPreference
:hasPreference rdf:type owl:ObjectProperty ;
               rdfs:domain <https://w3id.org/ofo#Person> ;
               rdfs:range :Preference ;
               rdfs:comment "Relates a person to their lighting preference profile, which specifies desired illuminance and colour temperature for a given visual task."@en ;
               rdfs:label "has preference" .


###  https://w3id.org/occo#includesFeedback
:includesFeedback rdf:type owl:ObjectProperty ;
                  rdfs:domain :PerformanceOutcome ;
                  rdfs:range <https://w3id.org/ofo#Feedback> ;
                  rdfs:comment "Relates a performance outcome to occupant feedback received following a lighting control actuation."@en ;
                  rdfs:label "includes feedback" .


###  https://w3id.org/occo#overrides
:overrides rdf:type owl:ObjectProperty ;
           rdfs:domain :OverrideEvent ;
           rdfs:range <http://www.w3.org/ns/sosa/Actuation> ;
           rdfs:comment "Relates an override event to the automated actuation it supersedes."@en ;
           rdfs:label "overrides" .


###  https://w3id.org/occo#preferredCCT
:preferredCCT rdf:type owl:ObjectProperty ;
              rdfs:domain :Preference ;
              rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
              rdfs:comment "Relates a preference to the occupant's desired correlated colour temperature, expressed as a quantity value in Kelvin."@en ;
              rdfs:label "preferred c c t" .


###  https://w3id.org/occo#preferredIlluminance
:preferredIlluminance rdf:type owl:ObjectProperty ;
                      rdfs:domain :Preference ;
                      rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
                      rdfs:comment "Relates a preference to the occupant's desired illuminance level, expressed as a quantity value in lux."@en ;
                      rdfs:label "preferred illuminance" .


###  https://w3id.org/occo#usesStrategy
:usesStrategy rdf:type owl:ObjectProperty ;
              rdfs:domain :Controller ;
              rdfs:range :ControlStrategy ;
              rdfs:comment "Relates a controller to the control strategy it is currently applying in a building space."@en ;
              rdfs:label "uses strategy" .


###  https://w3id.org/ofo#hasLocation
<https://w3id.org/ofo#hasLocation> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <https://w3id.org/ofo#Person> ;
                                   rdfs:range <https://saref.etsi.org/saref4bldg/BuildingSpace> ;
                                   rdfs:isDefinedBy <https://w3id.org/ofo> ;
                                   rdfs:label "has location" .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type owl:DatatypeProperty ;
                                      rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
                                      rdfs:label "identifier" .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:DatatypeProperty ;
                                  rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
                                  rdfs:label "issued" .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:DatatypeProperty ;
                                     rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
                                     rdfs:label "publisher" .


###  http://qudt.org/schema/qudt/numericValue
<http://qudt.org/schema/qudt/numericValue> rdf:type owl:DatatypeProperty ;
                                           rdfs:range xsd:double ;
                                           rdfs:isDefinedBy <http://qudt.org/schema/qudt/> ;
                                           rdfs:label "numeric value" .


###  http://www.w3.org/ns/prov#generatedAtTime
<http://www.w3.org/ns/prov#generatedAtTime> rdf:type owl:DatatypeProperty ;
                                            rdfs:range xsd:dateTime ;
                                            rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
                                            rdfs:label "generated at time" .


###  http://www.w3.org/ns/sosa/resultTime
<http://www.w3.org/ns/sosa/resultTime> rdf:type owl:DatatypeProperty ;
                                       rdfs:range xsd:dateTime ;
                                       rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                       rdfs:label "result time" .


###  https://w3id.org/occo#comfortScore
:comfortScore rdf:type owl:DatatypeProperty ;
              rdfs:domain :PerformanceOutcome ;
              rdfs:range xsd:decimal ;
              rdfs:comment "A decimal value representing the degree of visual comfort achieved by a lighting control actuation, assessed against occupant preferences."@en ;
              rdfs:label "comfort score" .


###  https://w3id.org/occo#meetsStandard
:meetsStandard rdf:type owl:DatatypeProperty ;
               rdfs:domain :PerformanceOutcome ;
               rdfs:range xsd:boolean ;
               rdfs:comment "A boolean value indicating whether a performance outcome satisfies the requirements of the applicable lighting standard."@en ;
               rdfs:label "meets standard" .


###  https://w3id.org/occo#strategyCategory
:strategyCategory rdf:type owl:DatatypeProperty ;
                  rdfs:domain :ControlStrategy ;
                  rdfs:range xsd:string ;
                  rdfs:comment "A string label categorising the type of control strategy applied, such as dimming, colour tuning, or scene-based control."@en ;
                  rdfs:label "strategy category" .


###  https://w3id.org/ofo#hasSimpleFeedbackState
<https://w3id.org/ofo#hasSimpleFeedbackState> rdf:type owl:DatatypeProperty ;
                                              rdfs:range xsd:string ;
                                              rdfs:isDefinedBy <https://w3id.org/ofo> ;
                                              rdfs:label "has simple feedback state" .


#################################################################
#    Classes
#################################################################

###  http://purl.org/dc/terms/Standard
<http://purl.org/dc/terms/Standard> rdf:type owl:Class ;
                                    rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
                                    rdfs:label "Standard" .


###  http://qudt.org/schema/qudt/QuantityValue
<http://qudt.org/schema/qudt/QuantityValue> rdf:type owl:Class ;
                                            rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://qudt.org/schema/qudt/numericValue> ;
                                                              owl:allValuesFrom xsd:double
                                                            ] ;
                                            rdfs:isDefinedBy <http://qudt.org/schema/qudt/> ;
                                            rdfs:label "Quantity Value" .


###  http://qudt.org/schema/qudt/Unit
<http://qudt.org/schema/qudt/Unit> rdf:type owl:Class ;
                                   rdfs:isDefinedBy <http://qudt.org/schema/qudt/> ;
                                   rdfs:label "Unit" .


###  http://www.w3.org/2006/time#Instant
<http://www.w3.org/2006/time#Instant> rdf:type owl:Class ;
                                      rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
                                      rdfs:label "Instant" .


###  http://www.w3.org/2006/time#Interval
<http://www.w3.org/2006/time#Interval> rdf:type owl:Class ;
                                       rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
                                       rdfs:label "Interval" .


###  http://www.w3.org/ns/prov#Agent
<http://www.w3.org/ns/prov#Agent> rdf:type owl:Class ;
                                  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
                                  rdfs:label "Agent" .


###  http://www.w3.org/ns/prov#SoftwareAgent
<http://www.w3.org/ns/prov#SoftwareAgent> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.w3.org/ns/prov#Agent> ;
                                          rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
                                          rdfs:label "Software Agent" .


###  http://www.w3.org/ns/sosa/Actuation
<http://www.w3.org/ns/sosa/Actuation> rdf:type owl:Class ;
                                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/prov#generatedAtTime> ;
                                                        owl:allValuesFrom xsd:dateTime
                                                      ] ;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                      rdfs:label "Actuation" .


###  http://www.w3.org/ns/sosa/Actuator
<http://www.w3.org/ns/sosa/Actuator> rdf:type owl:Class ;
                                     rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                     rdfs:label "Actuator" .


###  http://www.w3.org/ns/sosa/ObservableProperty
<http://www.w3.org/ns/sosa/ObservableProperty> rdf:type owl:Class ;
                                               rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                               rdfs:label "Observable Property" .


###  http://www.w3.org/ns/sosa/Observation
<http://www.w3.org/ns/sosa/Observation> rdf:type owl:Class ;
                                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/resultTime> ;
                                                          owl:allValuesFrom xsd:dateTime
                                                        ] ;
                                        rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                        rdfs:label "Observation" .


###  http://www.w3.org/ns/sosa/Sensor
<http://www.w3.org/ns/sosa/Sensor> rdf:type owl:Class ;
                                   rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                   rdfs:label "Sensor" .


###  https://saref.etsi.org/saref4bldg/BuildingSpace
<https://saref.etsi.org/saref4bldg/BuildingSpace> rdf:type owl:Class ;
                                                  rdfs:isDefinedBy <https://saref.etsi.org/saref4bldg/> ;
                                                  rdfs:label "Building Space" .


###  https://saref.etsi.org/saref4bldg/Lamp
<https://saref.etsi.org/saref4bldg/Lamp> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.w3.org/ns/sosa/Actuator> ;
                                         rdfs:isDefinedBy <https://saref.etsi.org/saref4bldg/> ;
                                         rdfs:label "Lamp" .


###  https://w3id.org/occo#CCT
:CCT rdf:type owl:Class ;
     rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty> ;
     rdfs:comment "Correlated Colour Temperature, an observable lighting property measured in Kelvin that characterises the warmth or coolness of a light source."@en ;
     rdfs:label "C C T" .


###  https://w3id.org/occo#Chronotype
:Chronotype rdf:type owl:Class ;
            rdfs:comment "A classification of an occupant's circadian preference, representing their natural tendency toward morning, intermediate, or evening activity patterns."@en ;
            rdfs:label "Chronotype" .


###  https://w3id.org/occo#ControlStrategy
:ControlStrategy rdf:type owl:Class ;
                 rdfs:comment "A defined approach for adjusting lighting parameters in a building space, such as dimming or colour tuning, selected by the controller to meet occupant requirements."@en ;
                 rdfs:label "Control Strategy" .


###  https://w3id.org/occo#Controller
:Controller rdf:type owl:Class ;
            rdfs:subClassOf <http://www.w3.org/ns/prov#SoftwareAgent> ;
            rdfs:comment "An automated software agent that selects and applies a lighting control strategy within a building space based on occupant preferences and environmental observations."@en ;
            rdfs:label "Controller" .


###  https://w3id.org/occo#GlareIndex
:GlareIndex rdf:type owl:Class ;
            rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty> ;
            rdfs:comment "A measure of visual discomfort caused by excessive brightness or contrast within the visual field, used as an observable lighting quality parameter."@en ;
            rdfs:label "Glare Index" .


###  https://w3id.org/occo#Illuminance
:Illuminance rdf:type owl:Class ;
             rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty> ;
             rdfs:comment "The luminous flux incident on a surface per unit area, measured in lux, used as a primary observable parameter for lighting control."@en ;
             rdfs:label "Illuminance" .


###  https://w3id.org/occo#OccupancyStatus
:OccupancyStatus rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty> ;
                 rdfs:comment "An observable property indicating whether a building space is currently occupied, used to trigger or suppress lighting control actions."@en ;
                 rdfs:label "Occupancy Status" .


###  https://w3id.org/occo#OverrideEvent
:OverrideEvent rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty <http://www.w3.org/ns/prov#generatedAtTime> ;
                                 owl:allValuesFrom xsd:dateTime
                               ] ;
               rdfs:comment "A manual intervention by an occupant that supersedes an automated lighting control actuation, recorded with a timestamp for audit and learning purposes."@en ;
               rdfs:label "Override Event" .


###  https://w3id.org/occo#PerformanceOutcome
:PerformanceOutcome rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :meetsStandard ;
                                      owl:allValuesFrom xsd:boolean
                                    ] ;
                    rdfs:comment "The result of a lighting control actuation, capturing comfort score, energy consumption, and compliance with applicable lighting standards."@en ;
                    rdfs:label "Performance Outcome" .


###  https://w3id.org/occo#Preference
:Preference rdf:type owl:Class ;
            rdfs:comment "A set of occupant-defined lighting preferences, including preferred illuminance and correlated colour temperature values for a given visual task."@en ;
            rdfs:label "Preference" .


###  https://w3id.org/occo#VisualTask
:VisualTask rdf:type owl:Class ;
            rdfs:comment "A task performed by an occupant that has specific visual requirements, such as reading, computer work, or collaborative meetings, which inform appropriate lighting conditions."@en ;
            rdfs:label "Visual Task" .


###  https://w3id.org/ofo#Feedback
<https://w3id.org/ofo#Feedback> rdf:type owl:Class ;
                                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                  owl:onProperty <http://www.w3.org/ns/prov#generatedAtTime> ;
                                                  owl:allValuesFrom xsd:dateTime
                                                ] ;
                                rdfs:isDefinedBy <https://w3id.org/ofo> ;
                                rdfs:label "Feedback" .


###  https://w3id.org/ofo#Person
<https://w3id.org/ofo#Person> rdf:type owl:Class ;
                              rdfs:isDefinedBy <https://w3id.org/ofo> ;
                              rdfs:label "Person" .


