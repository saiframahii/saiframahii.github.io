}, {
  "@id" : "https://w3id.org/mod#createdWith",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "https://w3id.org/occo#",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@value" : "Alramahi, S., Mayouf, M., Del Zendeh, E., & Ismail, K. (2026). Towards a Semantic Ontology for Occupant-Centric Building Control. Submitted to EC3 2026 — 12th European Conference on Construction IT."
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-09-24"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Saif Alramahi"
  }, {
    "@value" : "Mohammad Mayouf"
  }, {
    "@value" : "Elham Del Zendeh"
  }, {
    "@value" : "Khalid Ismail"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "A semantic framework for occupant-centric building control. This ontology is under active development and has not yet been fully validated."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-03-29"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-03-29"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@value" : "Birmingham City University"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/saiframahii/saiframahii.github.io"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "Occupant-Centric Control Ontology (OCCO)"
  } ],
  "http://purl.org/ontology/bibo/status" : [ {
    "@value" : "Ontology Specification Draft"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "occo"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@id" : "https://w3id.org/occo#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This ontology was developed as part of PhD research at Birmingham City University. The version presented here reflects the state at time of publication. The ontology will continue to evolve following formal validation and implementation."
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/occo/0.0.2"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "0.0.2-dev"
  } ],
  "https://w3id.org/mod#createdWith" : [ {
    "@id" : "https://chowlk.linkeddata.es/"
  } ]
}, {
  "@id" : "https://w3id.org/occo#CCT",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Correlated Colour Temperature, an observable lighting property measured in Kelvin that characterises the warmth or coolness of a light source."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "C C T"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/ObservableProperty"
  } ]
}, {
  "@id" : "https://w3id.org/occo#Chronotype",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A classification of an occupant's circadian preference, representing their natural tendency toward morning, intermediate, or evening activity patterns."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Chronotype"
  } ]
}, {
  "@id" : "https://w3id.org/occo#ControlStrategy",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A defined approach for adjusting lighting parameters in a building space, such as dimming or colour tuning, selected by the controller to meet occupant requirements."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Control Strategy"
  } ]
}, {
  "@id" : "https://w3id.org/occo#Controller",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An automated software agent that selects and applies a lighting control strategy within a building space based on occupant preferences and environmental observations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Controller"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/prov#SoftwareAgent"
  } ]
}, {
  "@id" : "https://w3id.org/occo#EN_12464_1_2021",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/identifier" : [ {
    "@value" : "EN 12464-1:2021"
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2021-08-31"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@value" : "BSI"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "Light and lighting. Lighting of work places - Indoor work places"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://purl.org/dc/terms/Standard"
  } ]
}, {
  "@id" : "https://w3id.org/occo#EveningType",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/occo#Chronotype"
  } ]
}, {
  "@id" : "https://w3id.org/occo#GlareIndex",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A measure of visual discomfort caused by excessive brightness or contrast within the visual field, used as an observable lighting quality parameter."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Glare Index"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/ObservableProperty"
  } ]
}, {
  "@id" : "https://w3id.org/occo#ISO_8995_1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/identifier" : [ {
    "@value" : "ISO 8995-1"
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-01-01"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@value" : "ISO"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "Light and lighting — Lighting of work places Part 1: Indoor"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://purl.org/dc/terms/Standard"
  } ]
}, {
  "@id" : "https://w3id.org/occo#Illuminance",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The luminous flux incident on a surface per unit area, measured in lux, used as a primary observable parameter for lighting control."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Illuminance"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/ObservableProperty"
  } ]
}, {
  "@id" : "https://w3id.org/occo#IntermediateType",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/occo#Chronotype"
  } ]
}, {
  "@id" : "https://w3id.org/occo#MorningType",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/occo#Chronotype"
  } ]
}, {
  "@id" : "https://w3id.org/occo#OccupancyStatus",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An observable property indicating whether a building space is currently occupied, used to trigger or suppress lighting control actions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Occupancy Status"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/ObservableProperty"
  } ]
}, {
  "@id" : "https://w3id.org/occo#OverrideEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A manual intervention by an occupant that supersedes an automated lighting control actuation, recorded with a timestamp for audit and learning purposes."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Override Event"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid4"
  } ]
}, {
  "@id" : "https://w3id.org/occo#PerformanceOutcome",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The result of a lighting control actuation, capturing comfort score, energy consumption, and compliance with applicable lighting standards."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Performance Outcome"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid5"
  } ]
}, {
  "@id" : "https://w3id.org/occo#Preference",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A set of occupant-defined lighting preferences, including preferred illuminance and correlated colour temperature values for a given visual task."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Preference"
  } ]
}, {
  "@id" : "https://w3id.org/occo#VisualTask",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A task performed by an occupant that has specific visual requirements, such as reading, computer work, or collaborative meetings, which inform appropriate lighting conditions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Visual Task"
  } ]
}, {
  "@id" : "https://w3id.org/occo#appliesToSpace",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relates a control strategy to the building space in which it is applied."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/occo#ControlStrategy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "applies to space"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://saref.etsi.org/saref4bldg/BuildingSpace"
  } ]
}, {
  "@id" : "https://w3id.org/occo#assessedAgainst",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relates a performance outcome to the lighting standard used to evaluate compliance."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/occo#PerformanceOutcome"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "assessed against"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://purl.org/dc/terms/Standard"
  } ]
}, {
  "@id" : "https://w3id.org/occo#comfortScore",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A decimal value representing the degree of visual comfort achieved by a lighting control actuation, assessed against occupant preferences."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/occo#PerformanceOutcome"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "comfort score"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#decimal"
  } ]
}, {
  "@id" : "https://w3id.org/occo#forTask",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relates a preference to the visual task for which it is defined."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/occo#Preference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "for task"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/occo#VisualTask"
  } ]
}, {
  "@id" : "https://w3id.org/occo#hasBaseline",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relates a performance outcome to a reference baseline outcome against which it is compared. This property is directional: the subject is the measured outcome, the object is the baseline."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/occo#PerformanceOutcome"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has baseline"
