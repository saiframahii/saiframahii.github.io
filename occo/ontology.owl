<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/occo#"
     xml:base="https://w3id.org/occo"
     xmlns:mod="https://w3id.org/mod#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/occo#">
        <owl:versionIRI rdf:resource="https://w3id.org/occo/0.1.1"/>
        <terms:bibliographicCitation>Alramahi, S., Mayouf, M., Del Zendeh, E., & Ismail, K. (2026). Towards a Semantic Ontology for Occupant-Centric Building Control. Submitted to EC3 2026 — 12th European Conference on Construction IT.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-24</terms:created>
        <terms:creator>Saif Alramahi</terms:creator>
        <terms:creator>Mohammad Mayouf</terms:creator>
        <terms:creator>Elham Del Zendeh</terms:creator>
        <terms:creator>Khalid Ismail</terms:creator>
        <terms:description xml:lang="en">A semantic framework for occupant-centric building control. This ontology is under active development and has not yet been fully validated.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-29</terms:modified>
        <terms:source rdf:resource="https://github.com/saiframahii/saiframahii.github.io"/>
        <terms:title xml:lang="en">Occupant-Centric Control Ontology (OCCO)</terms:title>
        <bibo:status>Ontology Specification Draft</bibo:status>
        <vann:preferredNamespacePrefix>occo</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://w3id.org/occo#"/>
        <rdfs:comment xml:lang="en">This ontology was developed as part of PhD research at Birmingham City University. The version presented here reflects the state at time of publication. The ontology will continue to evolve following formal validation and implementation.</rdfs:comment>
        <owl:versionInfo>0.1.1-dev</owl:versionInfo>
        <mod:createdWith rdf:resource="https://chowlk.linkeddata.es/"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/bibliographicCitation -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/source -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/ontology/bibo/status -->


    <owl:AnnotationProperty rdf:about="http://purl.org/ontology/bibo/status"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#comment -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#comment"/>
    


    <!-- http://www.w3.org/2002/07/owl#versionIRI -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionIRI"/>
    


    <!-- http://www.w3.org/2002/07/owl#versionInfo -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionInfo"/>
    


    <!-- https://w3id.org/mod#createdWith -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/mod#createdWith"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://qudt.org/schema/qudt/unit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/unit">
        <rdfs:domain rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt/"/>
        <rdfs:label>unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasBeginning -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasBeginning">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time"/>
        <rdfs:label>has beginning</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasEnd -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasEnd">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time"/>
        <rdfs:label>has end</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#atLocation -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#atLocation">
        <rdfs:domain rdf:resource="https://w3id.org/ofo#Feedback"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4bldg/BuildingSpace"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
        <rdfs:label>at location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#generated -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#generated">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <rdfs:range rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
        <rdfs:label>generated</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#used -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#used">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <rdfs:range rdf:resource="https://w3id.org/occo#ControlStrategy"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
        <rdfs:label>used</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasAssociatedWith -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith">
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
        <rdfs:label>was associated with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasAttributedTo -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
        <rdfs:domain rdf:resource="https://w3id.org/ofo#Feedback"/>
        <rdfs:range rdf:resource="https://w3id.org/ofo#Person"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
        <rdfs:label>was attributed to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasInformedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasInformedBy">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
        <rdfs:label>was informed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasFeatureOfInterest -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4bldg/BuildingSpace"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label>has feature of interest</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasResult -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasResult">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label>has result</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/madeByActuator -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeByActuator">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label>made by actuator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/madeBySensor -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeBySensor">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label>made by sensor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/observedProperty -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/observedProperty">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label>observed property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4bldg/isContainedIn -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4bldg/isContainedIn">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4bldg/Lamp"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4bldg/BuildingSpace"/>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/saref4bldg/"/>
        <rdfs:label>is contained in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/occo#appliesToSpace -->


    <owl:ObjectProperty rdf:about="https://w3id.org/occo#appliesToSpace">
        <rdfs:domain rdf:resource="https://w3id.org/occo#ControlStrategy"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4bldg/BuildingSpace"/>
        <rdfs:comment xml:lang="en">Relates a control strategy to the building space in which it is applied.</rdfs:comment>
        <rdfs:label>applies to space</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/occo#assessedAgainst -->


    <owl:ObjectProperty rdf:about="https://w3id.org/occo#assessedAgainst">
        <rdfs:domain rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
        <rdfs:range rdf:resource="http://purl.org/dc/terms/Standard"/>
        <rdfs:comment xml:lang="en">Relates a performance outcome to the lighting standard used to evaluate compliance.</rdfs:comment>
        <rdfs:label>assessed against</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/occo#forTask -->


    <owl:ObjectProperty rdf:about="https://w3id.org/occo#forTask">
        <rdfs:domain rdf:resource="https://w3id.org/occo#Preference"/>
        <rdfs:range rdf:resource="https://w3id.org/occo#VisualTask"/>
        <rdfs:comment xml:lang="en">Relates a preference to the visual task for which it is defined.</rdfs:comment>
        <rdfs:label>for task</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/occo#hasBaseline -->


    <owl:ObjectProperty rdf:about="https://w3id.org/occo#hasBaseline">
        <rdfs:domain rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
        <rdfs:range rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
        <rdfs:comment xml:lang="en">Relates a performance outcome to a reference baseline outcome against which it is compared. This property is directional: the subject is the measured outcome, the object is the baseline.</rdfs:comment>
        <rdfs:label>has baseline</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/occo#hasChronotype -->


    <owl:ObjectProperty rdf:about="https://w3id.org/occo#hasChronotype">
        <rdfs:domain rdf:resource="https://w3id.org/ofo#Person"/>
        <rdfs:range rdf:resource="https://w3id.org/occo#Chronotype"/>
        <rdfs:comment xml:lang="en">Relates a person to their chronotype classification, capturing their circadian activity pattern preference.</rdfs:comment>
        <rdfs:label>has chronotype</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/occo#hasEnergyConsumption -->


    <owl:ObjectProperty rdf:about="https://w3id.org/occo#hasEnergyConsumption">
        <rdfs:domain rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Relates a performance outcome to the energy consumption recorded during the associated lighting control actuation, expressed as a quantity value.</rdfs:comment>
        <rdfs:label>has energy consumption</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/occo#hasPreference -->


    <owl:ObjectProperty rdf:about="https://w3id.org/occo#hasPreference">
        <rdfs:domain rdf:resource="https://w3id.org/ofo#Person"/>
        <rdfs:range rdf:resource="https://w3id.org/occo#Preference"/>
        <rdfs:comment xml:lang="en">Relates a person to their lighting preference profile, which specifies desired illuminance and colour temperature for a given visual task.</rdfs:comment>
        <rdfs:label>has preference</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/occo#includesFeedback -->


    <owl:ObjectProperty rdf:about="https://w3id.org/occo#includesFeedback">
        <rdfs:domain rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
        <rdfs:range rdf:resource="https://w3id.org/ofo#Feedback"/>
        <rdfs:comment xml:lang="en">Relates a performance outcome to occupant feedback received following a lighting control actuation.</rdfs:comment>
        <rdfs:label>includes feedback</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/occo#overrides -->


    <owl:ObjectProperty rdf:about="https://w3id.org/occo#overrides">
        <rdfs:domain rdf:resource="https://w3id.org/occo#OverrideEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <rdfs:comment xml:lang="en">Relates an override event to the automated actuation it supersedes.</rdfs:comment>
        <rdfs:label>overrides</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/occo#preferredCCT -->


    <owl:ObjectProperty rdf:about="https://w3id.org/occo#preferredCCT">
        <rdfs:domain rdf:resource="https://w3id.org/occo#Preference"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Relates a preference to the occupant&apos;s desired correlated colour temperature, expressed as a quantity value in Kelvin.</rdfs:comment>
        <rdfs:label>preferred c c t</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/occo#preferredIlluminance -->


    <owl:ObjectProperty rdf:about="https://w3id.org/occo#preferredIlluminance">
        <rdfs:domain rdf:resource="https://w3id.org/occo#Preference"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:comment xml:lang="en">Relates a preference to the occupant&apos;s desired illuminance level, expressed as a quantity value in lux.</rdfs:comment>
        <rdfs:label>preferred illuminance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/occo#usesStrategy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/occo#usesStrategy">
        <rdfs:domain rdf:resource="https://w3id.org/occo#Controller"/>
        <rdfs:range rdf:resource="https://w3id.org/occo#ControlStrategy"/>
        <rdfs:comment xml:lang="en">Relates a controller to the control strategy it is currently applying in a building space.</rdfs:comment>
        <rdfs:label>uses strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ofo#hasLocation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ofo#hasLocation">
        <rdfs:domain rdf:resource="https://w3id.org/ofo#Person"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4bldg/BuildingSpace"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofo"/>
        <rdfs:label>has location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/identifier -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/identifier">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
        <rdfs:label>identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/issued">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
        <rdfs:label>issued</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/publisher">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
        <rdfs:label>publisher</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://qudt.org/schema/qudt/numericValue -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/numericValue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt/"/>
        <rdfs:label>numeric value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/prov#generatedAtTime -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#generatedAtTime">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
        <rdfs:label>generated at time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/sosa/resultTime -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/sosa/resultTime">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label>result time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/occo#comfortScore -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/occo#comfortScore">
        <rdfs:domain rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">A decimal value representing the degree of visual comfort achieved by a lighting control actuation, assessed against occupant preferences.</rdfs:comment>
        <rdfs:label>comfort score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/occo#meetsStandard -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/occo#meetsStandard">
        <rdfs:domain rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">A boolean value indicating whether a performance outcome satisfies the requirements of the applicable lighting standard.</rdfs:comment>
        <rdfs:label>meets standard</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/occo#strategyCategory -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/occo#strategyCategory">
        <rdfs:domain rdf:resource="https://w3id.org/occo#ControlStrategy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A string label categorising the type of control strategy applied, such as dimming, colour tuning, or scene-based control.</rdfs:comment>
        <rdfs:label>strategy category</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ofo#hasSimpleFeedbackState -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ofo#hasSimpleFeedbackState">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofo"/>
        <rdfs:label>has simple feedback state</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/Standard -->


    <owl:Class rdf:about="http://purl.org/dc/terms/Standard">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
        <rdfs:label>Standard</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/QuantityValue -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/QuantityValue">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/numericValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
