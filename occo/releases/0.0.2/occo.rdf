<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:mod="https://w3id.org/mod#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/madeByActuator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>made by actuator</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#assessedAgainst">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>assessed against</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a performance outcome to the lighting standard used to evaluate compliance.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
    <rdfs:range rdf:resource="http://purl.org/dc/terms/Standard"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#Agent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Agent</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/vocab/vann/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-24</dcterms:created>
    <dcterms:creator>Saif Alramahi</dcterms:creator>
    <dcterms:description xml:lang="en">A semantic framework for occupant-centric building control. This ontology is under active development and has not yet been fully validated.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:title xml:lang="en">Occupant-Centric Control Ontology (OCCO)</dcterms:title>
    <vann:preferredNamespacePrefix>occo</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri rdf:resource="https://w3id.org/occo#"/>
    <rdfs:comment xml:lang="en">This ontology was developed as part of PhD research at Birmingham City University. The version presented here reflects the state at time of publication. The ontology will continue to evolve following formal validation and implementation.</rdfs:comment>
    <owl:versionIRI rdf:resource="https://w3id.org/occo/0.0.2"/>
    <owl:versionInfo>0.0.2-dev</owl:versionInfo>
    <mod:createdWith rdf:resource="https://chowlk.linkeddata.es/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#VisualTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Visual Task</rdfs:label>
    <rdfs:comment xml:lang="en">A task performed by an occupant that has specific visual requirements, such as reading, computer work, or collaborative meetings, which inform appropriate lighting conditions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/publisher">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>publisher</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#used">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>used</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
    <rdfs:range rdf:resource="https://w3id.org/occo#ControlStrategy"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://qudt.org/schema/qudt/QuantityValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Quantity Value</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b1"/>
    <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#hasEnergyConsumption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has energy consumption</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a performance outcome to the energy consumption recorded during the associated lighting control actuation, expressed as a quantity value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/created">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ofo#hasLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has location</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ofo#Person"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/saref4bldg/BuildingSpace"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#IntermediateType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/occo#Chronotype"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ofo#hasSimpleFeedbackState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>has simple feedback state</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofo"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/creator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#overrides">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>overrides</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an override event to the automated actuation it supersedes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/occo#OverrideEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Observation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Observation</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b2"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/identifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>identifier</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/madeBySensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>made by sensor</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#ISO_8995_1">
    <rdf:type rdf:resource="http://purl.org/dc/terms/Standard"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:identifier>ISO 8995-1</dcterms:identifier>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-01</dcterms:issued>
    <dcterms:publisher>ISO</dcterms:publisher>
    <dcterms:title xml:lang="en">Light and lighting — Lighting of work places Part 1: Indoor</dcterms:title>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#PerformanceOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Performance Outcome</rdfs:label>
    <rdfs:comment xml:lang="en">The result of a lighting control actuation, capturing comfort score, energy consumption, and compliance with applicable lighting standards.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ofo#Feedback">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Feedback</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b4"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofo"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://qudt.org/schema/qudt/Unit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Unit</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4bldg/BuildingSpace">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Building Space</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/saref4bldg/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#hasPreference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has preference</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a person to their lighting preference profile, which specifies desired illuminance and colour temperature for a given visual task.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/ofo#Person"/>
    <rdfs:range rdf:resource="https://w3id.org/occo#Preference"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2006/time#hasEnd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has end</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2006/time#Interval"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>was attributed to</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ofo#Feedback"/>
    <rdfs:range rdf:resource="https://w3id.org/ofo#Person"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#strategyCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>strategy category</rdfs:label>
    <rdfs:comment xml:lang="en">A string label categorising the type of control strategy applied, such as dimming, colour tuning, or scene-based control.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/occo#ControlStrategy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#CCT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>C C T</rdfs:label>
    <rdfs:comment xml:lang="en">Correlated Colour Temperature, an observable lighting property measured in Kelvin that characterises the warmth or coolness of a light source.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#includesFeedback">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>includes feedback</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a performance outcome to occupant feedback received following a lighting control actuation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
    <rdfs:range rdf:resource="https://w3id.org/ofo#Feedback"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#SoftwareAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Software Agent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#Controller">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Controller</rdfs:label>
    <rdfs:comment xml:lang="en">An automated software agent that selects and applies a lighting control strategy within a building space based on occupant preferences and environmental observations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#SoftwareAgent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#wasInformedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>was informed by</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#comfortScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>comfort score</rdfs:label>
    <rdfs:comment xml:lang="en">A decimal value representing the degree of visual comfort achieved by a lighting control actuation, assessed against occupant preferences.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Actuator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Actuator</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has feature of interest</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/saref4bldg/BuildingSpace"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>title</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ofo#Person">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Person</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#OccupancyStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Occupancy Status</rdfs:label>
    <rdfs:comment xml:lang="en">An observable property indicating whether a building space is currently occupied, used to trigger or suppress lighting control actions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://qudt.org/schema/qudt/unit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>unit</rdfs:label>
    <rdfs:domain rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#appliesToSpace">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>applies to space</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a control strategy to the building space in which it is applied.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/occo#ControlStrategy"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/saref4bldg/BuildingSpace"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#usesStrategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>uses strategy</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a controller to the control strategy it is currently applying in a building space.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/occo#Controller"/>
    <rdfs:range rdf:resource="https://w3id.org/occo#ControlStrategy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2006/time#hasBeginning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has beginning</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2006/time#Interval"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#preferredCCT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>preferred c c t</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a preference to the occupant's desired correlated colour temperature, expressed as a quantity value in Kelvin.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/occo#Preference"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#atLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>at location</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ofo#Feedback"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/saref4bldg/BuildingSpace"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#EN_12464_1_2021">
    <rdf:type rdf:resource="http://purl.org/dc/terms/Standard"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:identifier>EN 12464-1:2021</dcterms:identifier>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-31</dcterms:issued>
    <dcterms:publisher>BSI</dcterms:publisher>
    <dcterms:title xml:lang="en">Light and lighting. Lighting of work places - Indoor work places</dcterms:title>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>was associated with</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ObservableProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Observable Property</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDifferent"/>
    <owl:members rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b8"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#generatedAtTime"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#generatedAtTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#GlareIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Glare Index</rdfs:label>
    <rdfs:comment xml:lang="en">A measure of visual discomfort caused by excessive brightness or contrast within the visual field, used as an observable lighting quality parameter.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4bldg/isContainedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>is contained in</rdfs:label>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4bldg/Lamp"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/saref4bldg/BuildingSpace"/>
    <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/saref4bldg/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Sensor</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <owl:onProperty rdf:resource="https://w3id.org/occo#meetsStandard"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/issued">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>issued</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has result</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#hasBaseline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has baseline</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a performance outcome to a reference baseline outcome against which it is compared. This property is directional: the subject is the measured outcome, the object is the baseline.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
    <rdfs:range rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Actuation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Actuation</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b3"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#versionInfo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#generated">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>generated</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
    <rdfs:range rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#MorningType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/occo#Chronotype"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#generatedAtTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>generated at time</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/vocab/vann/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#forTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>for task</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a preference to the visual task for which it is defined.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/occo#Preference"/>
    <rdfs:range rdf:resource="https://w3id.org/occo#VisualTask"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4bldg/Lamp">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Lamp</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
    <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/saref4bldg/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#OverrideEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Override Event</rdfs:label>
    <rdfs:comment xml:lang="en">A manual intervention by an occupant that supersedes an automated lighting control actuation, recorded with a timestamp for audit and learning purposes.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b5"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#hasChronotype">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has chronotype</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a person to their chronotype classification, capturing their circadian activity pattern preference.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/ofo#Person"/>
    <rdfs:range rdf:resource="https://w3id.org/occo#Chronotype"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/resultTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>result time</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://qudt.org/schema/qudt/numericValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>numeric value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#EveningType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/occo#Chronotype"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#Preference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Preference</rdfs:label>
    <rdfs:comment xml:lang="en">A set of occupant-defined lighting preferences, including preferred illuminance and correlated colour temperature values for a given visual task.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/Standard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Standard</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#Chronotype">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Chronotype</rdfs:label>
    <rdfs:comment xml:lang="en">A classification of an occupant's circadian preference, representing their natural tendency toward morning, intermediate, or evening activity patterns.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/numericValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#meetsStandard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>meets standard</rdfs:label>
    <rdfs:comment xml:lang="en">A boolean value indicating whether a performance outcome satisfies the requirements of the applicable lighting standard.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/occo#PerformanceOutcome"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2000/01/rdf-schema#comment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2006/time#Interval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Interval</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#Illuminance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Illuminance</rdfs:label>
    <rdfs:comment xml:lang="en">The luminous flux incident on a surface per unit area, measured in lux, used as a primary observable parameter for lighting control.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#generatedAtTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#preferredIlluminance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>preferred illuminance</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a preference to the occupant's desired illuminance level, expressed as a quantity value in lux.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/occo#Preference"/>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b9">
    <rdf:first rdf:resource="https://w3id.org/occo#EveningType"/>
    <rdf:rest rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/observedProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>observed property</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2006/time#Instant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Instant</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/occo#ControlStrategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Control Strategy</rdfs:label>
    <rdfs:comment xml:lang="en">A defined approach for adjusting lighting parameters in a building space, such as dimming or colour tuning, selected by the controller to meet occupant requirements.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b10">
    <rdf:first rdf:resource="https://w3id.org/occo#IntermediateType"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b8">
    <rdf:first rdf:resource="https://w3id.org/occo#MorningType"/>
    <rdf:rest rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b9"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7990c2dcf2fc49f0a55018d86cc8c188b2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/resultTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#versionIRI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
</rdf:RDF>
