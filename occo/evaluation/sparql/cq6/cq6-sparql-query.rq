# CQ6: Which building spaces have circadian-friendly lighting control strategies
# applied, based on occupant chronotype?

PREFIX occo: <https://w3id.org/occo#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX s4bldg: <https://saref.etsi.org/saref4bldg/>
PREFIX ofo: <https://w3id.org/ofo#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?spaceLabel ?strategyLabel ?observationTime ?cctValue
WHERE {
    ?strategy a occo:ControlStrategy ;
              rdfs:label ?strategyLabel ;
              occo:strategyCategory ?category ;
              occo:appliesToSpace ?space .

    FILTER(REGEX(?category, "Circadian", "i"))

    ?space rdfs:label ?spaceLabel .

    ?obs a sosa:Observation ;
         sosa:observedProperty ?cctProp ;
         sosa:hasFeatureOfInterest ?space ;
         sosa:hasSimpleResult ?cctValue ;
         sosa:resultTime ?observationTime .

    ?cctProp a occo:CCT .
}
ORDER BY ?spaceLabel ?observationTime
