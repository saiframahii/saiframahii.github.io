# CQ10: Which control strategy achieves the best balance of energy efficiency,
# occupant satisfaction, and compliance with comfort standards?

PREFIX occo: <https://w3id.org/occo#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX s4bldg: <https://saref.etsi.org/saref4bldg/>
PREFIX ofo: <https://w3id.org/ofo#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?strategyLabel ?category ?comfortScore ?energyKwh ?meetsStandard
WHERE {
    ?outcome a occo:PerformanceOutcome ;
             occo:assessedAgainst occo:EN_12464_1_2021 ;
             occo:meetsStandard "true"^^xsd:boolean ;
             occo:meetsStandard ?meetsStandard ;
             occo:comfortScore ?comfortScore ;
             occo:hasEnergyConsumption ?energyQV ;
             prov:wasGeneratedBy ?strategy .

    ?strategy rdfs:label ?strategyLabel ;
              occo:strategyCategory ?category .

    ?energyQV qudt:numericValue ?energyKwh .
}
ORDER BY DESC(?comfortScore) ASC(?energyKwh)
