# CQ5: How has an occupant's lighting preference profile changed over time?

PREFIX occo: <https://w3id.org/occo#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX s4bldg: <https://saref.etsi.org/saref4bldg/>
PREFIX ofo: <https://w3id.org/ofo#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?personLabel ?taskLabel ?preferredLux ?preferredKelvin ?timestamp
WHERE {
    ?person a ofo:Person ;
            rdfs:label ?personLabel ;
            occo:hasPreference ?pref .

    ?pref occo:forTask ?task ;
          occo:preferredIlluminance ?illumQV ;
          occo:preferredCCT ?cctQV ;
          prov:generatedAtTime ?timestamp .

    ?task rdfs:label ?taskLabel .
    ?illumQV qudt:numericValue ?preferredLux .
    ?cctQV qudt:numericValue ?preferredKelvin .
}
ORDER BY ?personLabel ?taskLabel ?timestamp
